rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Bug fix: status === 'active' with legacy active:boolean fallback
    function isActive() {
      let u = userDoc();
      return u.get('status', null) == 'active'
          || (u.get('status', null) == null && u.get('active', false) == true);
    }

    function role() {
      return userDoc().role;
    }

    function isOwner()    { return isAuth() && role() == 'owner'    && isActive(); }
    function isAdmin()    { return isAuth() && role() == 'admin'    && isActive(); }
    function isEmployee() { return isAuth() && role() == 'employee' && isActive(); }
    function isStaff()    { return isOwner() || isAdmin(); }
    function isAnyActive(){ return isOwner() || isAdmin() || isEmployee(); }

    function hasPerm(category, action) {
      let gp = userDoc().get('granularPermissions', null);
      return gp != null
          && gp.get(category, null) != null
          && gp[category].get(action, false) == true;
    }

    // ─── users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:          if isAuth() && (request.auth.uid == uid || isStaff());
      allow create:        if isStaff();
      allow update:        if isOwner()
                           || (isAdmin() && resource.data.role != 'owner');
      allow delete:        if isOwner();
    }

    // ─── subscribers ──────────────────────────────────────────────────────
    match /subscribers/{id} {
      allow read:          if isAnyActive();
      allow create:        if isStaff() || hasPerm('subscribers', 'create');
      allow update:        if isStaff() || hasPerm('subscribers', 'edit');
      allow delete:        if isOwner() || hasPerm('subscribers', 'delete');
    }

    // ─── payments ─────────────────────────────────────────────────────────
    match /payments/{id} {
      allow read:          if isAnyActive();
      allow create:        if isStaff() || hasPerm('payments', 'create');
      allow update:        if isStaff() || hasPerm('payments', 'edit');
      allow delete:        if isOwner();
    }

    // ─── refunds ──────────────────────────────────────────────────────────
    match /refunds/{id} {
      allow read:          if isAnyActive();
      allow create:        if isStaff() || hasPerm('payments', 'refund');
      allow update:        if isOwner();
      allow delete:        if isOwner();
    }

    // ─── auditLogs — immutable after creation ─────────────────────────────
    match /auditLogs/{id} {
      allow read:          if isStaff() || hasPerm('logs', 'view');
      allow create:        if isAnyActive();
      allow update, delete: if false;
    }

    // ─── notifications ────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read:          if isAnyActive();
      allow create:        if isStaff();
      allow update:        if isStaff();
      allow delete:        if isOwner();
    }

    // ─── monthlyAnalytics — Cloud Functions write only ────────────────────
    match /monthlyAnalytics/{month} {
      allow read:          if isStaff() || hasPerm('analytics', 'view');
      allow write:         if false;
    }

    // ─── exchangeRates ────────────────────────────────────────────────────
    match /exchangeRates/{id} {
      allow read:          if isAnyActive();
      allow write:         if isStaff();
    }

    // ─── deny everything else ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
