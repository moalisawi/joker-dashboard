rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Bug fix: status === 'active' with legacy active:boolean fallback
    function isActive() {
      let u = userDoc();
      return u.get('status', null) == 'active'
          || (u.get('status', null) == null && u.get('active', false) == true);
    }

    function role() {
      return userDoc().role;
    }

    function isOwner()    { return isAuth() && role() == 'owner'    && isActive(); }
    function isAdmin()    { return isAuth() && role() == 'admin'    && isActive(); }
    function isEmployee() { return isAuth() && role() == 'employee' && isActive(); }
    function isStaff()    { return isOwner() || isAdmin(); }
    function isAnyActive(){ return isOwner() || isAdmin() || isEmployee(); }

    function hasPerm(category, action) {
      let gp = userDoc().get('granularPermissions', null);
      return gp != null
          && gp.get(category, null) != null
          && gp[category].get(action, false) == true;
    }

    // ─── users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:          if isAuth() && (request.auth.uid == uid || isStaff());
      allow create, update: if isOwner();
      allow delete:         if false;
    }

    // ─── teams ────────────────────────────────────────────────────────────
    match /teams/{id} {
      allow read:           if isAnyActive();
      allow create, update: if isOwner();
      allow delete:         if false;
    }

    // ─── subscribers ──────────────────────────────────────────────────────
    match /subscribers/{id} {
      allow read:          if isAnyActive();
      allow create, update, delete: if false;

      // renewalHistory sub-collection — server-only writes, any active user can read
      match /renewalHistory/{rid} {
        allow read:  if isAnyActive();
        allow write: if false;
      }
    }

    // ─── payments ─────────────────────────────────────────────────────────
    match /payments/{id} {
      allow read:          if isStaff()
                           || hasPerm('analytics', 'view')
                           || hasPerm('payments', 'view');
      allow create, update, delete: if false;
    }

    // ─── refunds ──────────────────────────────────────────────────────────
    match /refunds/{id} {
      allow read:          if isStaff()
                           || hasPerm('analytics', 'view')
                           || hasPerm('payments', 'view');
      allow create, update, delete: if false;
    }

    // ─── auditLogs — server-only writes (Admin SDK) ───────────────────────────
    // Client writes are blocked to prevent forged audit entries.
    match /auditLogs/{id} {
      allow read:  if isStaff() || hasPerm('logs', 'view');
      allow write: if false;
    }

    // ─── notifications ────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read:          if isAnyActive();
      allow create:        if isStaff();
      // Staff can update any field; any active user can only update readBy/archived
      allow update:        if isStaff()
                           || (isAnyActive()
                               && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['readBy', 'archived']));
      allow delete:        if isOwner();
    }

    // ─── monthlyAnalytics — Cloud Functions write only ────────────────────
    match /monthlyAnalytics/{month} {
      allow read:          if isStaff() || hasPerm('analytics', 'view');
      allow write:         if false;
    }

    // ─── exchangeRates ────────────────────────────────────────────────────
    match /exchangeRates/{id} {
      allow read:            if isAnyActive();
      allow create, update:  if isStaff();
      allow delete:          if isOwner();
    }

    // ─── subscriberNotes ─────────────────────────────────────────────────
    match /subscriberNotes/{id} {
      allow read:   if isAnyActive();
      allow create: if isAnyActive();
      // Author can edit/soft-delete their own notes (must still be active)
      allow update: if isAnyActive() && request.auth.uid == resource.data.authorId;
      allow delete: if false;
    }

    // ─── paymentMethods ───────────────────────────────────────────────────
    match /paymentMethods/{id} {
      allow read:          if isAnyActive();
      allow create, update: if isStaff() || hasPerm('settings', 'manage');
      allow delete:         if false;
    }

    // ─── loginSessions — staff-read only; Admin SDK writes only ─────────
    match /loginSessions/{id} {
      allow read:          if isStaff();
      allow write:         if false;
    }

    // ─── failedLogins — staff-read only; Admin SDK writes only ───────────
    match /failedLogins/{id} {
      allow read:          if isStaff();
      allow write:         if false;
    }

    // ─── activityLogs — server-only writes (Admin SDK) ────────────────────
    match /activityLogs/{id} {
      allow read:  if isStaff() || hasPerm('logs', 'view');
      allow write: if false;
    }

    // ─── subscriberAssignments — server-only writes (Admin SDK) ───────────
    // Written by the API route after updating the subscriber document.
    match /subscriberAssignments/{id} {
      allow read:  if isAnyActive();
      allow write: if false;
    }

    // ─── whatsappLeads — reads by any active user; writes via Admin SDK only ──
    match /whatsappLeads/{id} {
      allow read:               if isAnyActive();
      allow create, update:     if false;  // Admin SDK only (API route)
      allow delete:             if false;
    }

    // ─── whatsappMessages — reads by any active user; writes via Admin SDK ────
    match /whatsappMessages/{id} {
      allow read:               if isAnyActive();
      allow create, update:     if false;  // Admin SDK only (API route)
      allow delete:             if false;
    }

    // ─── cannedResponses — read by any active user; write by staff only ───────
    match /cannedResponses/{id} {
      allow read:               if isAnyActive();
      allow create, update:     if isStaff();
      allow delete:             if false;
    }

    // ─── deny everything else ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
