rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Bug fix: status === 'active' with legacy active:boolean fallback
    function isActive() {
      let u = userDoc();
      return u.get('status', null) == 'active'
          || (u.get('status', null) == null && u.get('active', false) == true);
    }

    function role() {
      return userDoc().role;
    }

    function isOwner()    { return isAuth() && role() == 'owner'    && isActive(); }
    function isAdmin()    { return isAuth() && role() == 'admin'    && isActive(); }
    function isEmployee() { return isAuth() && role() == 'employee' && isActive(); }
    function isStaff()    { return isOwner() || isAdmin(); }
    function isAnyActive(){ return isOwner() || isAdmin() || isEmployee(); }

    function hasPerm(category, action) {
      let gp = userDoc().get('granularPermissions', null);
      return gp != null
          && gp.get(category, null) != null
          && gp[category].get(action, false) == true;
    }

    // ─── Subscriber row-level read guard for employees ─────────────────────
    //
    // Security model:
    //  • Owners and admins can read all subscriber records.
    //  • Employees can ONLY read records where THEY are the convincer.
    //
    // Two-tier lookup for backward compatibility:
    //  1. New records store convincedByUid (employee Firebase UID) — fast,
    //     tamper-proof, survives name changes. This is the preferred path.
    //  2. Legacy records have only convincedBy (employee display name). We fall
    //     back to matching that against the current user's employeeName but ONLY
    //     when convincedByUid is absent (null / missing). This ensures that once
    //     a record is migrated to use the UID, the name-based bypass is gone.
    //
    // NOTE: userDoc() reads are cached per-request by Firestore, so the
    // call inside canReadSubscriber() does not add a second document read
    // beyond what isOwner/isAdmin/isEmployee already triggered.
    // NOTE: a rules function must be a single return expression. `if` statements
    // are not part of the language — an earlier version of this function used one,
    // which made the whole file fail validation with INVALID_ARGUMENT and is why
    // it sat undeployed while the weaker previous ruleset stayed live. The two
    // paths below are the same logic expressed as a ternary.
    function canReadSubscriberAsEmployee() {
      let uid     = request.auth.uid;
      let sub     = resource.data;
      let empName = userDoc().get('employeeName', '');
      return sub.get('convincedByUid', null) != null
        // Path 1 — UID-based (current records)
        ? sub.get('convincedByUid', '') == uid
        // Path 2 — Name-based fallback (legacy records without convincedByUid)
        : (empName != '' && sub.get('convincedBy', '') == empName);
    }

    // ─── users ────────────────────────────────────────────────────────────
    // All user-doc writes go through the Admin SDK (API routes) which bypass
    // these rules. Blocking client writes here enforces the architectural
    // contract and prevents privilege escalation (e.g. self-promoting to owner).
    match /users/{uid} {
      allow read:           if isAuth() && (request.auth.uid == uid || isStaff());
      allow create, update: if false;
      allow delete:         if false;
    }

    // ─── teams ────────────────────────────────────────────────────────────
    match /teams/{id} {
      allow read:           if isAnyActive();
      allow create, update: if isOwner();
      allow delete:         if false;
    }

    // ─── subscribers ──────────────────────────────────────────────────────
    // SECURITY FIX: Employees can only read their own subscribers.
    // Previously any active user could read all subscribers. This rule scopes
    // employee reads to records where they are the convincedBy party.
    match /subscribers/{id} {
      allow read:   if isStaff()
                    || (isEmployee() && canReadSubscriberAsEmployee());
      // All writes go through the Admin SDK (API routes) — client writes blocked.
      allow create, update, delete: if false;

      // renewalHistory sub-collection — server-only writes
      match /renewalHistory/{rid} {
        allow read:  if isStaff()
                     || (isEmployee() && canReadSubscriberAsEmployee());
        allow write: if false;
      }
    }

    // ─── payments ─────────────────────────────────────────────────────────
    // SECURITY FIX: Employees with analytics/payments view can only see
    // payments linked to their own subscribers (via subscriberId field).
    // Staff (owner/admin) see everything.
    match /payments/{id} {
      allow read:   if isStaff()
                    || (isEmployee()
                        && (hasPerm('analytics', 'view') || hasPerm('payments', 'view'))
                        && resource.data.get('convincedByUid', null) != null
                        && resource.data.get('convincedByUid', '') == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ─── refunds ──────────────────────────────────────────────────────────
    // Was: any authenticated user holding analytics.view OR payments.view could
    // read every refund in the business — the whole refund ledger, including
    // amounts and reasons for subscribers they have no connection to. Employee
    // reads are now scoped the same way payments are.
    //
    // withdrawSubscriber denormalises convincedByUid onto new refunds. Refunds
    // written before that stay staff-only, which is the safe direction to fail;
    // run scripts/backfill-refund-convinced-by-uid.mjs to restore employee
    // access to the historical ones.
    match /refunds/{id} {
      allow read:   if isStaff()
                    || (isEmployee()
                        && (hasPerm('analytics', 'view') || hasPerm('payments', 'view'))
                        && resource.data.get('convincedByUid', null) != null
                        && resource.data.get('convincedByUid', '') == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ─── auditLogs — server-only writes (Admin SDK) ───────────────────────────
    match /auditLogs/{id} {
      allow read:  if isStaff() || (isAuth() && hasPerm('logs', 'view'));
      allow write: if false;
    }

    // ─── notifications ────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read:          if isAnyActive();
      allow create:        if isStaff();
      allow update:        if isStaff()
                           || (isAnyActive()
                               && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['readBy', 'archived']));
      allow delete:        if isOwner();
    }

    // ─── monthlyAnalytics — Cloud Functions write only ────────────────────
    match /monthlyAnalytics/{month} {
      allow read:          if isStaff() || (isAuth() && hasPerm('analytics', 'view'));
      allow write:         if false;
    }

    // ─── exchangeRates ────────────────────────────────────────────────────
    match /exchangeRates/{id} {
      allow read:            if isAnyActive();
      allow create, update:  if isStaff();
      allow delete:          if isOwner();
    }

    // ─── subscriberNotes ─────────────────────────────────────────────────
    // Was: any active user could read every note on every subscriber, which is
    // the most sensitive free text in the system — health details, payment
    // disputes, personal circumstances — while the subscriber records those
    // notes describe were already scoped to the owning employee. The note was
    // the way around the subscriber rule.
    //
    // Notes are always queried by subscriberId (subscriberNotes.service), so a
    // denormalised convincedByUid scopes reads without changing any query. An
    // employee may also always read a note they wrote.
    //
    // Creates now require the employee to stamp their own uid, so a note cannot
    // be filed under someone else's name. Legacy notes carry no uid and are
    // staff-only until backfilled.
    match /subscriberNotes/{id} {
      allow read:   if isStaff()
                    || (isEmployee()
                        && (resource.data.get('convincedByUid', '') == request.auth.uid
                            || resource.data.get('authorId', '') == request.auth.uid));
      allow create: if isStaff()
                    || (isEmployee()
                        && request.resource.data.get('authorId', '') == request.auth.uid
                        && request.resource.data.get('convincedByUid', '') == request.auth.uid);
      allow update: if isAnyActive() && request.auth.uid == resource.data.authorId;
      allow delete: if false;
    }

    // ─── paymentMethods ───────────────────────────────────────────────────
    match /paymentMethods/{id} {
      allow read:           if isAnyActive();
      allow create, update: if isStaff() || (isAuth() && hasPerm('settings', 'manage'));
      allow delete:         if false;
    }

    // ─── loginSessions — staff-read only; Admin SDK writes only ─────────
    match /loginSessions/{id} {
      allow read:          if isStaff();
      allow write:         if false;
    }

    // ─── failedLogins — staff-read only; Admin SDK writes only ───────────
    match /failedLogins/{id} {
      allow read:          if isStaff();
      allow write:         if false;
    }

    // ─── activityLogs — server-only writes (Admin SDK) ────────────────────
    match /activityLogs/{id} {
      allow read:  if isStaff() || (isAuth() && hasPerm('logs', 'view'));
      allow write: if false;
    }

    // ─── subscriberAssignments — server-only writes (Admin SDK) ───────────
    // Was readable by any active user. This is the transfer ledger: who took a
    // subscriber from whom, when, and why. It reveals the whole book of business
    // — every subscriber id and name, and the commercial relationships between
    // staff — to people who cannot read the subscribers themselves.
    //
    // An employee sees only transfers they were a party to. Anything broader is
    // a supervisor view.
    match /subscriberAssignments/{id} {
      allow read:  if isStaff()
                   || (isEmployee()
                       && (resource.data.get('fromEmployeeId', '') == request.auth.uid
                           || resource.data.get('toEmployeeId', '') == request.auth.uid
                           || resource.data.get('transferredBy', '') == request.auth.uid));
      allow write: if false;
    }

    // ─── whatsappLeads ─────────────────────────────────────────────────────
    match /whatsappLeads/{id} {
      allow read:               if isAnyActive();
      allow create, update:     if false;
      allow delete:             if false;
    }

    // ─── whatsappMessages ──────────────────────────────────────────────────
    match /whatsappMessages/{id} {
      allow read:               if isAnyActive();
      allow create, update:     if false;
      allow delete:             if false;
    }

    // ─── cannedResponses ───────────────────────────────────────────────────
    match /cannedResponses/{id} {
      allow read:               if isAnyActive();
      allow create, update:     if isStaff();
      allow delete:             if false;
    }

    // ─── deny everything else ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
